# API keys are added in the Connections UI, not committed to the repository.
# Persist this directory and its .encryption-key when hosting.
OPENVID_DATA_DIR=./data
OPENVID_RENDER_WORKERS=2
# Set a random access token before exposing the instance to the internet.
OPENVID_ACCESS_TOKEN=
# Only enable for trusted self-hosted endpoints such as local models.
OPENVID_ALLOW_LOCAL_PROVIDERS=false
